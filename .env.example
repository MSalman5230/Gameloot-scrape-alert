# MongoDB. The database name is taken from the URI path (default: gamelootScrape).
# Use "memory://" for a throwaway in-process store while developing.
MONGODB_URI=mongodb://user:pass@host:27017/gamelootScrape?authSource=admin

# Telegram. Without these, alerts are only written to the log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=123456789,987654321

# Optional
LOG_LEVEL=INFO
PORT=8000
DEFAULT_MAX_CONCURRENT_RUNS=5
RUN_TIMEOUT_SECONDS=900
